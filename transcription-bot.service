[Unit]
Description=Transcription Bot - Telegram bot for audio/video transcription with VIP management
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shima
Group=shima
WorkingDirectory=/home/shima/bots/transcription_bot
Environment="PATH=/home/shima/.local/bin:/home/shima/.local/share/uv/python/cpython-3.12.11-linux-x86_64-gnu/bin:/usr/local/bin:/usr/bin:/bin"
Environment="VIRTUAL_ENV=/home/shima/bots/transcription_bot/.venv"
ExecStart=/home/shima/bots/transcription_bot/.venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=append:/home/shima/bots/transcription_bot/bot.log
StandardError=append:/home/shima/bots/transcription_bot/bot_error.log

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
